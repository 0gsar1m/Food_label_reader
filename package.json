  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "api": "tsx watch server/index.ts",
    "api:start": "node --import tsx server/index.ts",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build:web && playwright test",
    "build": "expo export --platform all",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build && npm run build:api && npm run test:api-bundle",
    "build:api": "esbuild server/index.ts --bundle --platform=node --format=cjs --legal-comments=eof --outfile=dist-api/server.cjs",
    "test:api-bundle": "tsx scripts/smoke-api.ts",
    "costs": "tsx scripts/costs.ts",
    "preview": "tsx scripts/preview.ts",
    "build:web": "expo export --platform web",
    "api:economy": "tsx scripts/api-economy.ts"
  },
  "private": true

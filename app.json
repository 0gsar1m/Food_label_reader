{
  "expo": {
    "name": "Nazif",
    "slug": "etiket-food-label-reader",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ogsarim.etiket",
      "infoPlist": {
        "NSCameraUsageDescription": "Gıda etiketinin fotoğrafını çekmek için kamera izni gerekir.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.ogsarim.etiket",
      "versionCode": 9,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F6F4ED"
      },
      "permissions": ["CAMERA"],
      "blockedPermissions": ["android.permission.RECORD_AUDIO"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Gıda etiketini fotoğraflamak için kameraya izin ver.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Etiket fotoğrafını seçmek için galeriyi kullan.",
          "cameraPermission": "Etiket fotoğrafını çekmek için kamerayı kullan.",
          "microphonePermission": false
        }
      ],
      "expo-secure-store",
      "expo-font"
    ],
    "scheme": "etiket",
    "backgroundColor": "#F6F4ED"
  }
}

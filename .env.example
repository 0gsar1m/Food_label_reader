# API server secrets. Never use EXPO_PUBLIC_ for a provider key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
PORT=8787
# Required (24+ characters) when NODE_ENV=production.
# APP_ACCESS_TOKEN=
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8082
TRUST_PROXY_HOPS=0

# Mobile app: public endpoint only. Use your PC's LAN IP for a physical phone.
EXPO_PUBLIC_API_URL=http://localhost:8787

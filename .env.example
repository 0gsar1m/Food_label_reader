# API server secrets. Never use EXPO_PUBLIC_ for a provider key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
PORT=8787
# Production: use a 24+ character service token OR configure verified Google sessions.
# APP_ACCESS_TOKEN=
# GUEST_ACCESS_UNTIL=2026-11-12T00:00:00+03:00
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8082
TRUST_PROXY_HOPS=0

# Mobile app: public endpoint only. Use your PC's LAN IP for a physical phone.
EXPO_PUBLIC_API_URL=http://localhost:8787

# Health-context language model, separate from Vision. Never public.
PERSONAL_MODEL=gemini-3.5-flash-lite

# Google Sign-In: IDs are public; session signing secret is server-only.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
GOOGLE_CLIENT_IDS=
# Generate a random 32+ character secret for server session signing.
# SESSION_SECRET=
REQUIRE_GOOGLE_AUTH=false
